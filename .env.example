# =============================================================================
# E-COMMERCE MICROSERVICES PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update values based on your environment
# Usage: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME=ecommerce-microservices
APP_VERSION=1.0.0
APP_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# MySQL / MariaDB Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root

# Database Names
DB_NAME_USER=user_db
DB_NAME_PRODUCT=product_db
DB_NAME_ORDER=order_db
DB_NAME_PAYMENT=payment_db

# Hikari Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=60000

# -----------------------------------------------------------------------------
# APACHE KAFKA CONFIGURATION
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_CONSUMER_GROUP_ID=ecommerce-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka Topics
KAFKA_TOPIC_ORDER=order_topics
KAFKA_TOPIC_CREATE_ORDER=create_order_topic
KAFKA_TOPIC_PRODUCT=product_topics

# -----------------------------------------------------------------------------
# EUREKA SERVICE REGISTRY
# -----------------------------------------------------------------------------
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://${EUREKA_HOST}:${EUREKA_PORT}/eureka/

# -----------------------------------------------------------------------------
# API GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=9191

# -----------------------------------------------------------------------------
# SERVICE PORTS
# -----------------------------------------------------------------------------
SERVICE_IDENTITY_PORT=9898
SERVICE_PRODUCT_PORT=8084
SERVICE_ORDER_PORT=8080
SERVICE_PAYMENT_PORT=8085
SERVICE_EMAIL_PORT=8086

# -----------------------------------------------------------------------------
# SECURITY & JWT CONFIGURATION
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-256-bits
JWT_EXPIRATION=86400000
JWT_TOKEN_PREFIX=Bearer
JWT_HEADER_NAME=Authorization

# -----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Optional - for image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your-email-password
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM_NAME=E-Commerce Platform
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# PAYPAL CONFIGURATION (Optional - for payment processing)
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api.sandbox.paypal.com

# -----------------------------------------------------------------------------
# ZIPKIN DISTRIBUTED TRACING (Optional)
# -----------------------------------------------------------------------------
ZIPKIN_BASE_URL=http://localhost:9411
SPRING_SLEUTH_SAMPLER_PROBABILITY=1

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# -----------------------------------------------------------------------------
# DOCKER CONFIGURATION (Used by docker-compose.yml)
# -----------------------------------------------------------------------------
DOCKER_NETWORK_NAME=ecommerce-network
MYSQL_DATA_VOLUME=./data/mysql
REDIS_DATA_VOLUME=./data/redis
KAFKA_DATA_VOLUME=./data/kafka